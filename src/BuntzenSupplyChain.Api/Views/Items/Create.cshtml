@model SupplyItem
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add New Item";
}

<div class="card-table-wrapper" style="max-width:600px; margin:0 auto;">
    <h2 style="margin-bottom:1rem; color:var(--primary-navy);">Add New Medical Supply Item</h2>
    
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label>Item Number (SKU):</label>
            <input asp-for="ItemNumber" required class="form-control" placeholder="e.g. PHSA-PPE-901" />
        </div>

        <div class="form-group">
            <label>Item Name:</label>
            <input asp-for="Name" required class="form-control" placeholder="e.g. Surgical Face Mask" />
        </div>

        <div class="form-group">
            <label>Category:</label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<ItemCategory>()" class="form-control"></select>
        </div>

        <div class="form-group">
            <label>Unit Price ($):</label>
            <input asp-for="UnitPrice" type="number" step="0.01" required class="form-control" />
        </div>

        <div class="form-group">
            <label>Reorder Point Threshold:</label>
            <input asp-for="DefaultReorderPoint" type="number" required class="form-control" />
        </div>

        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-action" style="background-color:var(--success-green);">Save New Item</button>
            <a asp-action="Index" class="btn-outline">Cancel</a>
        </div>
    </form>
</div>
